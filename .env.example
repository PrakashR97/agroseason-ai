# Copy to .env (never commit .env). Placeholders only.

# --- Paid APIs (leave empty to disable; cached/verified data is still served) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SERPER_API_KEY=

# --- Docker / production (read by docker compose) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:8088
# Production only (docker-compose.prod.yml, existing Traefik on the VPS):
DOMAIN=agroseason.example.com
TRAEFIK_NETWORK=traefik_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Cost controls ---
RATE_LIMIT_PER_MINUTE=120
RESEARCH_RATE_LIMIT_PER_HOUR=5
SERPER_DAILY_LIMIT=100
OPENAI_DAILY_LIMIT=100
MONTHLY_BUDGET_USD=10
RESEARCH_CACHE_TTL_DAYS=30

# --- Local (non-Docker) development only ---
# DATABASE_URL=postgresql+psycopg://agro:CHANGE_ME@localhost:5432/agroseason
# REDIS_URL=redis://127.0.0.1:6379/0
# MEDIA_DIR=./data/media
